# =============================================================================
# DiscoTQ 環境変数のサンプル
#
# ローカル開発: このファイルを .env.local にコピーして値を入れる（.env* は git 管理外）
# 本番 / プレビュー: Vercel の Project Settings > Environment Variables に設定する
#
# ⚠️ 重要: VITE_ で始まる変数はビルド時にフロントエンドの JS に埋め込まれ、誰でも読めます。
#    秘密情報（R2 のキー、DATABASE_URL、RESEND_API_KEY など）には
#    絶対に VITE_ を付けないでください。
# =============================================================================

# ----------------------------------------------------------------------------- サーバー側（FastAPI）
# 未設定の必須項目があると API は起動時にエラーになります

# Cloudflare R2（S3 互換 API）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=discotq-private
R2_BUCKET_PUBLIC=discotq-public
# public バケットに割り当てたカスタムドメイン（r2.dev は本番で使わない）
R2_PUBLIC_BASE_URL=https://media.example.com
# 任意: S3 互換のローカルサーバーなどを使う場合のみ（通常は空。account_id から自動で組み立てる）
# R2_ENDPOINT_URL=http://localhost:9000

# Supabase Postgres の transaction pooler（ポート 6543）
# 例: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# アップロード制限: コードの既定値を使うため設定不要（必要なときだけ上書き）
#   MAX_UPLOAD_BYTES=104857600 / MAX_VIDEO_DURATION_SEC=180 / ANON_DAILY_UPLOAD_LIMIT=5 / USER_DAILY_UPLOAD_LIMIT=50

# API の CORS 許可オリジン（カンマ区切り）。同一ドメイン運用なら空でも可
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 認証
# メール内リンクの組み立てに使うフロントの URL。既定は https://discotq.vercel.app（本番では設定不要）
# ローカル開発ではリンクを手元に向けるため上書きする
APP_BASE_URL=http://localhost:3000
# IP アドレスのハッシュ化に使うソルトは DATABASE_URL から自動で導出する（設定不要）
# ローカル (http) では false。本番では true（既定）
SESSION_COOKIE_SECURE=false

# メール送信（Resend）。ローカルでは console にすると送信内容を API のログに出す
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=DiscoTQ <no-reply@example.com>

# ----------------------------------------------------------------------------- フロント側（Vite）
# 同一ドメイン（Vercel）で配信する場合は空のまま（/api を使う）
VITE_API_BASE_URL=

# ローカル開発のみ: Vite の /api プロキシ先（既定 http://127.0.0.1:8000）。VITE_ を付けないのでフロントには露出しない
# API_PROXY_TARGET=http://127.0.0.1:8000
